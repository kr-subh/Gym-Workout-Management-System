<%- include('../partials/header') %>

<main class="dashboard-page">
  <div class="lock-card" style="border-color: rgba(34, 197, 94, 0.3);">
    <div class="lock-icon-circle" style="background: rgba(34, 197, 94, 0.15); border-color: rgba(34, 197, 94, 0.4);">
      <span class="lock-icon">✨</span>
    </div>
    
    <div class="badge badge-pro-plus" style="margin-bottom: 0.75rem;">Unlocked by <%= membership.name %></div>
    <h2 class="lock-title"><%= featureLabel %></h2>
    <p class="text-muted" style="max-width: 480px; margin: 0 auto 1.5rem;">
      You have active access to this feature under your <strong><%= membership.level %></strong> membership.
    </p>

    <div class="lock-actions">
      <a href="/member/plans" class="btn btn-outline">View All Plans</a>
      <a href="/member/dashboard" class="btn btn-primary">Go to Dashboard →</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
