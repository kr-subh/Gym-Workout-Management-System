<%- include('../partials/header') %>

<main class="dashboard-page">

  <div class="admin-header-row">
    <div>
      <div class="dashboard-eyebrow">Member / My Workout Plan</div>
      <h1>My Workout Plan</h1>
      <% if (trainer) { %>
        <p class="text-muted">Created by your trainer: <strong><%= trainer.name %></strong></p>
      <% } %>
    </div>
    <a href="/member/dashboard" class="btn btn-secondary">← Dashboard</a>
  </div>

  <% if (errorMsg) { %>
    <div class="alert alert-error" style="margin-bottom:1.5rem;"><%= errorMsg %></div>
  <% } %>

  <% if (!plan) { %>
    <!-- No plan yet -->
    <div class="empty-state" style="margin-top:2.5rem;">
      <div style="font-size:3.5rem;margin-bottom:1rem;">📋</div>
      <p style="font-size:1.1rem;font-weight:600;margin-bottom:0.5rem;">No Workout Plan Yet</p>
      <p class="text-muted">
        <% if (trainer) { %>
          Your trainer <strong><%= trainer.name %></strong> hasn't created a workout plan for you yet. Check back soon!
        <% } else { %>
          No trainer has been assigned to you yet. Ask your admin to assign a trainer.
        <% } %>
      </p>
    </div>
  <% } else { %>

    <!-- Plan overview -->
    <div class="detail-card" style="margin-top:2rem;">
      <div class="detail-rows">
        <% if (plan.trainer) { %>
          <div class="detail-row">
            <span class="detail-label">Assigned Trainer</span>
            <span class="detail-value"><%= plan.trainer.name %></span>
          </div>
        <% } %>
        <% if (plan.schedule) { %>
          <div class="detail-row">
            <span class="detail-label">Schedule</span>
            <span class="detail-value"><%= plan.schedule %></span>
          </div>
        <% } %>
        <% if (plan.notes) { %>
          <div class="detail-row">
            <span class="detail-label">Trainer Notes</span>
            <span class="detail-value"><%= plan.notes %></span>
          </div>
        <% } %>
        <div class="detail-row">
          <span class="detail-label">Total Exercises</span>
          <span class="detail-value"><%= plan.exercises ? plan.exercises.length : 0 %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Last Updated</span>
          <span class="detail-value"><%= new Date(plan.updatedAt).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %></span>
        </div>
      </div>
    </div>

    <!-- Exercises grouped by day -->
    <% if (plan.exercises && plan.exercises.length > 0) { %>
      <%
        const byDay = {};
        plan.exercises.forEach(ex => {
          const d = ex.day || 'General';
          if (!byDay[d]) byDay[d] = [];
          byDay[d].push(ex);
        });
        const dayOrder = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday','General'];
        const sortedDays = Object.keys(byDay).sort((a, b) => {
          const ai = dayOrder.indexOf(a);
          const bi = dayOrder.indexOf(b);
          return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
        });
      %>

      <% sortedDays.forEach(day => { %>
        <div class="workout-day-section">
          <div class="workout-day-header">
            <span class="workout-day-label">📅 <%= day %></span>
            <span class="workout-day-count"><%= byDay[day].length %> exercise<%= byDay[day].length !== 1 ? 's' : '' %></span>
          </div>

          <div class="data-table-wrap">
            <table class="data-table workout-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Exercise</th>
                  <th>Sets</th>
                  <th>Reps</th>
                  <th>Trainer Notes</th>
                </tr>
              </thead>
              <tbody>
                <% byDay[day].forEach((ex, i) => { %>
                  <tr>
                    <td class="text-muted"><%= i + 1 %></td>
                    <td><strong><%= ex.exerciseName %></strong></td>
                    <td><span class="exercise-badge"><%= ex.sets %></span></td>
                    <td><span class="exercise-badge exercise-badge-reps"><%= ex.reps %></span></td>
                    <td class="text-muted"><%= ex.notes || '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% }) %>

    <% } else { %>
      <p class="text-muted" style="margin-top:1rem;font-style:italic;">No exercises in this plan yet.</p>
    <% } %>

    <!-- Read-only notice -->
    <div class="alert" style="margin-top:2rem;background:rgba(59,130,246,0.08);border-color:rgba(59,130,246,0.25);color:#93c5fd;">
      ℹ️ This workout plan is managed by your trainer. Contact your trainer to make changes.
    </div>

  <% } %>

</main>

<%- include('../partials/footer') %>
