<%- include('../partials/header') %>

<main class="dashboard-page">

  <div class="admin-header-row">
    <div>
      <div class="dashboard-eyebrow">Member / My Diet Plan</div>
      <h1>My Diet Plan</h1>
      <% if (trainer) { %>
        <p class="text-muted">Prescribed by your trainer: <strong><%= trainer.name %></strong></p>
      <% } %>
    </div>
    <a href="/member/dashboard" class="btn btn-secondary">← Dashboard</a>
  </div>

  <% if (errorMsg) { %>
    <div class="alert alert-error" style="margin-bottom:1.5rem;"><%= errorMsg %></div>
  <% } %>

  <!-- Diet Preference & Overview -->
  <div class="detail-card" style="margin-top:2rem;margin-bottom:1.5rem;">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
      <div>
        <span class="detail-label" style="display:block;margin-bottom:0.25rem;">My Diet Preference</span>
        <span class="diet-pref-badge diet-pref-<%= (member?.dietPreference || 'vegetarian').toLowerCase().replace(' ','-') %>">
          🥗 <%= member?.dietPreference || 'Not Specified' %>
        </span>
      </div>
      <% if (plan) { %>
        <div>
          <span class="detail-label" style="display:block;margin-bottom:0.25rem;">Prescribed Diet Type</span>
          <span class="diet-pref-badge diet-pref-<%= (plan.dietPreference || 'vegetarian').toLowerCase().replace(' ','-') %>">
            🎯 <%= plan.dietPreference || member?.dietPreference || 'Vegetarian' %>
          </span>
        </div>
      <% } %>
    </div>
  </div>

  <% if (!plan) { %>
    <!-- No plan yet -->
    <div class="empty-state" style="margin-top:2.5rem;">
      <div style="font-size:3.5rem;margin-bottom:1rem;">🥗</div>
      <p style="font-size:1.1rem;font-weight:600;margin-bottom:0.5rem;">No Diet Plan Yet</p>
      <p class="text-muted">
        <% if (trainer) { %>
          Your trainer <strong><%= trainer.name %></strong> hasn't created a diet plan for you yet. Check back soon!
        <% } else { %>
          No trainer has been assigned to you yet. Ask your admin to assign a trainer.
        <% } %>
      </p>
    </div>
  <% } else { %>

    <!-- Plan metadata card -->
    <div class="detail-card" style="margin-bottom:1.5rem;">
      <div class="detail-rows">
        <% if (plan.trainer) { %>
          <div class="detail-row">
            <span class="detail-label">Prescribed By</span>
            <span class="detail-value"><%= plan.trainer.name %></span>
          </div>
        <% } %>
        <% if (plan.notes) { %>
          <div class="detail-row">
            <span class="detail-label">Trainer Notes & Instructions</span>
            <span class="detail-value"><%= plan.notes %></span>
          </div>
        <% } %>
        <div class="detail-row">
          <span class="detail-label">Total Meal Items</span>
          <span class="detail-value"><%= plan.meals ? plan.meals.length : 0 %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Last Updated</span>
          <span class="detail-value"><%= new Date(plan.updatedAt).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %></span>
        </div>
      </div>
    </div>

    <!-- Meals grouped by meal type -->
    <% if (plan.meals && plan.meals.length > 0) { %>
      <%
        const mealOrder = ['Breakfast', 'Lunch', 'Snack', 'Dinner'];
        const byType = {};
        plan.meals.forEach(m => {
          const t = m.mealType || 'Breakfast';
          if (!byType[t]) byType[t] = [];
          byType[t].push(m);
        });
        const sortedTypes = Object.keys(byType).sort((a, b) => {
          const ai = mealOrder.indexOf(a);
          const bi = mealOrder.indexOf(b);
          return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
        });
      %>

      <% sortedTypes.forEach(type => { %>
        <div class="workout-day-section">
          <div class="workout-day-header">
            <span class="workout-day-label">
              <% if (type === 'Breakfast') { %>🍳<% } else if (type === 'Lunch') { %>🍲<% } else if (type === 'Snack') { %>🍎<% } else if (type === 'Dinner') { %>🍽️<% } else { %>🥗<% } %>
              <%= type %>
            </span>
            <span class="workout-day-count"><%= byType[type].length %> item<%= byType[type].length !== 1 ? 's' : '' %></span>
          </div>

          <div class="data-table-wrap">
            <table class="data-table workout-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Food</th>
                  <th>Quantity</th>
                  <th>Timing</th>
                  <th>Notes</th>
                </tr>
              </thead>
              <tbody>
                <% byType[type].forEach((meal, i) => { %>
                  <tr>
                    <td class="text-muted"><%= i + 1 %></td>
                    <td><strong><%= meal.food %></strong></td>
                    <td><span class="diet-qty-badge"><%= meal.quantity || '—' %></span></td>
                    <td><span class="diet-timing-badge"><%= meal.timing || '—' %></span></td>
                    <td class="text-muted"><%= meal.notes || '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% }) %>

    <% } else { %>
      <p class="text-muted" style="margin-top:1rem;font-style:italic;">No meals in this plan yet.</p>
    <% } %>

    <!-- Read-only notice -->
    <div class="alert" style="margin-top:2rem;background:rgba(59,130,246,0.08);border-color:rgba(59,130,246,0.25);color:#93c5fd;">
      ℹ️ This diet plan is prescribed and managed by your trainer. Contact your trainer if you need adjustments.
    </div>

  <% } %>

</main>

<%- include('../partials/footer') %>
