<%- include('../../partials/header') %>

<main class="dashboard-page">

  <!-- Header -->
  <div class="admin-header-row">
    <div>
      <div class="dashboard-eyebrow">Trainer / <%= member.name %></div>
      <h1>Workout Plan</h1>
      <p class="text-muted">Managing plan for <strong><%= member.name %></strong>
        <% if (member.membership) { %>
          · <span class="badge badge-<%= member.membership.level.toLowerCase().replace('+','-plus') %>"><%= member.membership.level %></span>
        <% } %>
      </p>
    </div>
    <a href="/trainer/dashboard" class="btn btn-secondary">← Dashboard</a>
  </div>

  <% if (successMsg) { %>
    <div class="alert alert-success" style="margin-bottom:1.5rem;"><%= successMsg %></div>
  <% } %>
  <% if (errorMsg) { %>
    <div class="alert alert-error" style="margin-bottom:1.5rem;"><%= errorMsg %></div>
  <% } %>

  <% if (!plan) { %>
    <!-- No plan yet -->
    <div class="empty-state" style="margin-top:2rem;">
      <div style="font-size:3rem;margin-bottom:1rem;">📋</div>
      <p>No workout plan created for <strong><%= member.name %></strong> yet.</p>
      <a href="/trainer/members/<%= member._id %>/workout/new" class="btn btn-primary" style="margin-top:1.25rem;">
        + Create Workout Plan
      </a>
    </div>
  <% } else { %>
    <!-- Plan overview -->
    <div class="workout-plan-header-strip">
      <div>
        <% if (plan.schedule) { %>
          <p><span class="detail-label">Schedule:</span> <strong><%= plan.schedule %></strong></p>
        <% } %>
        <% if (plan.notes) { %>
          <p style="margin-top:0.5rem;"><span class="detail-label">Notes:</span> <%= plan.notes %></p>
        <% } %>
        <p style="margin-top:0.5rem;" class="text-muted" style="font-size:0.8rem;">
          Last updated: <%= new Date(plan.updatedAt).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
        </p>
      </div>
      <div class="header-actions">
        <a href="/trainer/members/<%= member._id %>/workout/edit" class="btn btn-outline">✏️ Edit Plan</a>
        <form action="/trainer/members/<%= member._id %>/workout/delete" method="POST"
              onsubmit="return confirm('Delete this workout plan? This cannot be undone.');">
          <button type="submit" class="btn btn-danger btn-sm">🗑 Delete</button>
        </form>
      </div>
    </div>

    <!-- Exercises Table -->
    <% if (plan.exercises && plan.exercises.length > 0) { %>
      <%
        // Group exercises by day
        const byDay = {};
        plan.exercises.forEach(ex => {
          const d = ex.day || 'General';
          if (!byDay[d]) byDay[d] = [];
          byDay[d].push(ex);
        });
      %>

      <% Object.keys(byDay).forEach(day => { %>
        <div class="workout-day-section">
          <div class="workout-day-header">
            <span class="workout-day-label">📅 <%= day %></span>
            <span class="workout-day-count"><%= byDay[day].length %> exercise<%= byDay[day].length !== 1 ? 's' : '' %></span>
          </div>
          <div class="data-table-wrap">
            <table class="data-table workout-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Exercise</th>
                  <th>Sets</th>
                  <th>Reps</th>
                  <th>Notes</th>
                </tr>
              </thead>
              <tbody>
                <% byDay[day].forEach((ex, i) => { %>
                  <tr>
                    <td class="text-muted"><%= i + 1 %></td>
                    <td><strong><%= ex.exerciseName %></strong></td>
                    <td><span class="exercise-badge"><%= ex.sets %></span></td>
                    <td><span class="exercise-badge exercise-badge-reps"><%= ex.reps %></span></td>
                    <td class="text-muted"><%= ex.notes || '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p class="text-muted" style="margin-top:1rem;font-style:italic;">No exercises added to this plan yet.</p>
    <% } %>
  <% } %>

</main>

<%- include('../../partials/footer') %>
