<%- include('../../partials/header') %>

<main class="dashboard-page">

  <!-- Header -->
  <div class="admin-header-row">
    <div>
      <div class="dashboard-eyebrow">Trainer / <%= member.name %></div>
      <h1>Diet Plan</h1>
      <p class="text-muted">Managing diet plan for <strong><%= member.name %></strong>
        <% if (member.membership) { %>
          · <span class="badge badge-<%= member.membership.level.toLowerCase().replace('+','-plus') %>"><%= member.membership.level %></span>
        <% } %>
      </p>
    </div>
    <a href="/trainer/dashboard" class="btn btn-secondary">← Dashboard</a>
  </div>

  <% if (successMsg) { %>
    <div class="alert alert-success" style="margin-bottom:1.5rem;"><%= successMsg %></div>
  <% } %>
  <% if (errorMsg) { %>
    <div class="alert alert-error" style="margin-bottom:1.5rem;"><%= errorMsg %></div>
  <% } %>

  <!-- Member Diet Preference Banner -->
  <div class="detail-card" style="margin-bottom:1.5rem;">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.75rem;">
      <div>
        <span class="detail-label" style="display:block;margin-bottom:0.25rem;">Member's Stated Preference</span>
        <span class="diet-pref-badge diet-pref-<%= (member.dietPreference || 'vegetarian').toLowerCase().replace(' ','-') %>">
          🥗 <%= member.dietPreference || 'Not Specified' %>
        </span>
      </div>
      <% if (plan) { %>
        <div>
          <span class="detail-label" style="display:block;margin-bottom:0.25rem;">Plan Diet Type</span>
          <span class="diet-pref-badge diet-pref-<%= (plan.dietPreference || 'vegetarian').toLowerCase().replace(' ','-') %>">
            🎯 <%= plan.dietPreference || member.dietPreference || 'Vegetarian' %>
          </span>
        </div>
      <% } %>
    </div>
  </div>

  <% if (!plan) { %>
    <!-- No plan yet -->
    <div class="empty-state" style="margin-top:2rem;">
      <div style="font-size:3rem;margin-bottom:1rem;">🥗</div>
      <p>No diet plan created for <strong><%= member.name %></strong> yet.</p>
      <p class="text-muted" style="font-size:0.9rem;margin-top:0.35rem;">Member preference: <strong><%= member.dietPreference || 'Vegetarian' %></strong></p>
      <a href="/trainer/members/<%= member._id %>/diet/new" class="btn btn-primary" style="margin-top:1.25rem;">
        + Create Diet Plan
      </a>
    </div>
  <% } else { %>
    <!-- Plan overview -->
    <div class="workout-plan-header-strip">
      <div>
        <% if (plan.notes) { %>
          <p><span class="detail-label">Trainer Notes:</span> <%= plan.notes %></p>
        <% } %>
        <p style="margin-top:0.5rem;" class="text-muted" style="font-size:0.8rem;">
          Last updated: <%= new Date(plan.updatedAt).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
        </p>
      </div>
      <div class="header-actions">
        <a href="/trainer/members/<%= member._id %>/diet/edit" class="btn btn-outline">✏️ Edit Plan</a>
        <form action="/trainer/members/<%= member._id %>/diet/delete" method="POST"
              onsubmit="return confirm('Delete this diet plan? This cannot be undone.');">
          <button type="submit" class="btn btn-danger btn-sm">🗑 Delete</button>
        </form>
      </div>
    </div>

    <!-- Meals Table grouped by Meal Type -->
    <% if (plan.meals && plan.meals.length > 0) { %>
      <%
        const mealOrder = ['Breakfast', 'Lunch', 'Snack', 'Dinner'];
        const byType = {};
        plan.meals.forEach(m => {
          const t = m.mealType || 'Breakfast';
          if (!byType[t]) byType[t] = [];
          byType[t].push(m);
        });
        const sortedTypes = Object.keys(byType).sort((a, b) => {
          const ai = mealOrder.indexOf(a);
          const bi = mealOrder.indexOf(b);
          return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
        });
      %>

      <% sortedTypes.forEach(type => { %>
        <div class="workout-day-section">
          <div class="workout-day-header">
            <span class="workout-day-label">
              <% if (type === 'Breakfast') { %>🍳<% } else if (type === 'Lunch') { %>🍲<% } else if (type === 'Snack') { %>🍎<% } else if (type === 'Dinner') { %>🍽️<% } else { %>🥗<% } %>
              <%= type %>
            </span>
            <span class="workout-day-count"><%= byType[type].length %> item<%= byType[type].length !== 1 ? 's' : '' %></span>
          </div>
          <div class="data-table-wrap">
            <table class="data-table workout-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Food</th>
                  <th>Quantity</th>
                  <th>Timing</th>
                  <th>Notes</th>
                </tr>
              </thead>
              <tbody>
                <% byType[type].forEach((meal, i) => { %>
                  <tr>
                    <td class="text-muted"><%= i + 1 %></td>
                    <td><strong><%= meal.food %></strong></td>
                    <td><span class="diet-qty-badge"><%= meal.quantity || '—' %></span></td>
                    <td><span class="diet-timing-badge"><%= meal.timing || '—' %></span></td>
                    <td class="text-muted"><%= meal.notes || '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p class="text-muted" style="margin-top:1rem;font-style:italic;">No meals added to this diet plan yet.</p>
    <% } %>
  <% } %>

</main>

<%- include('../../partials/footer') %>
