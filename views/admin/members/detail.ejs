<%- include('../../partials/header') %>

<main class="dashboard-page">
  <div class="admin-header-row">
    <div>
      <div class="dashboard-eyebrow">Admin / Members / Detail</div>
      <h1><%= member.name %></h1>
      <p class="text-muted"><%= member.email %></p>
    </div>
    <div class="header-actions">
      <a href="/admin/members" class="btn btn-secondary">← All Members</a>
      <a href="/admin/members/<%= member._id %>/edit" class="btn btn-outline">Edit Member</a>
    </div>
  </div>

  <% if (successMsg) { %>
    <div class="alert alert-success" style="margin-bottom:1.5rem;"><%= successMsg %></div>
  <% } %>
  <% if (errorMsg) { %>
    <div class="alert alert-error" style="margin-bottom:1.5rem;"><%= errorMsg %></div>
  <% } %>

  <div class="detail-grid">

    <!-- Member Info Card -->
    <div class="detail-card">
      <h3 class="detail-card-title">👤 Member Details</h3>
      <div class="detail-rows">
        <div class="detail-row">
          <span class="detail-label">Name</span>
          <span class="detail-value"><%= member.name %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Email</span>
          <span class="detail-value"><%= member.email %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Phone</span>
          <span class="detail-value"><%= member.phone || '—' %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Diet Preference</span>
          <span class="detail-value"><%= member.dietPreference || '—' %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Joined</span>
          <span class="detail-value"><%= new Date(member.createdAt).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %></span>
        </div>
      </div>
    </div>

    <!-- Membership Card -->
    <div class="detail-card">
      <h3 class="detail-card-title">💳 Membership Status</h3>
      <% if (member.membership) { %>
        <div class="detail-rows">
          <div class="detail-row">
            <span class="detail-label">Plan</span>
            <span class="detail-value"><%= member.membership.name %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Level</span>
            <span class="badge badge-<%= member.membership.level.toLowerCase().replace('+','-plus') %>"><%= member.membership.level %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Duration</span>
            <span class="detail-value"><%= member.membership.duration %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Price</span>
            <span class="detail-value">₹<%= Number(member.membership.price).toLocaleString('en-IN') %></span>
          </div>
        </div>
      <% } else { %>
        <p class="text-muted" style="margin-top:0.75rem;font-style:italic;">No membership plan assigned.</p>
      <% } %>
    </div>

    <!-- Trainer Assignment Card -->
    <div class="detail-card">
      <h3 class="detail-card-title">🏋️ Assigned Trainer</h3>
      <% if (member.trainer) { %>
        <div class="detail-rows">
          <div class="detail-row">
            <span class="detail-label">Name</span>
            <span class="detail-value"><%= member.trainer.name %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Email</span>
            <span class="detail-value"><%= member.trainer.email %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Phone</span>
            <span class="detail-value"><%= member.trainer.phone || '—' %></span>
          </div>
        </div>
      <% } else { %>
        <p class="text-muted" style="margin-top:0.75rem;font-style:italic;">No trainer assigned.</p>
      <% } %>

      <!-- Assign Trainer -->
      <form action="/admin/members/<%= member._id %>/assign-trainer" method="POST" style="margin-top:1.25rem;">
        <div class="form-group">
          <label for="trainerId">Change / Assign Trainer</label>
          <select name="trainerId" id="trainerId">
            <option value="">— Remove assignment —</option>
            <% if (locals.trainers && trainers.length) { %>
              <% trainers.forEach(t => { %>
                <option value="<%= t._id %>" <%= member.trainer && ((member.trainer._id || member.trainer).toString()) === t._id.toString() ? 'selected' : '' %>><%= t.name %> (<%= t.email %>)</option>
              <% }) %>
            <% } %>
          </select>
        </div>
        <button type="submit" class="btn btn-sm btn-primary" style="margin-top:0.5rem;">Save Assignment</button>
      </form>
    </div>

    <!-- Danger Zone -->
    <div class="detail-card detail-card-danger">
      <h3 class="detail-card-title">⚠️ Actions</h3>
      <div class="danger-actions">
        <form action="/admin/members/<%= member._id %>/deactivate" method="POST" onsubmit="return confirm('Deactivate this member? They will no longer be able to log in.');">
          <button type="submit" class="btn btn-sm btn-outline btn-warn-outline">Deactivate Member</button>
        </form>
        <form action="/admin/members/<%= member._id %>/delete" method="POST" onsubmit="return confirm('Permanently delete this member? This cannot be undone.');">
          <button type="submit" class="btn btn-sm btn-danger">Delete Member</button>
        </form>
      </div>
    </div>

  </div>
</main>

<%- include('../../partials/footer') %>
