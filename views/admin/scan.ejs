<%- include('../partials/header') %>

<main class="dashboard-page kiosk-container">

  <!-- FITZONE GYM ENTRANCE KIOSK HEADER -->
  <div class="kiosk-header">
    <div class="kiosk-header-left">
      <div class="kiosk-badge-row">
        <span class="kiosk-status-pill ready">
          <span class="kiosk-status-dot"></span> KIOSK ACTIVE
        </span>
        <span class="kiosk-gate-tag">GATE 01 · TURNSTILE ENTRANCE</span>
      </div>
      <h1 class="kiosk-main-title">FITZONE GYM ENTRANCE</h1>
      <p class="kiosk-subtitle">Member Access & Automated Attendance Verification Terminal</p>
    </div>

    <div class="kiosk-header-right">
      <div class="kiosk-clock-panel">
        <div id="kiosk-digital-clock" class="kiosk-clock-digits">--:--:--</div>
        <div id="kiosk-digital-date" class="kiosk-clock-date">--------</div>
      </div>
    </div>
  </div>

  <!-- KIOSK GRID LAYOUT -->
  <div class="kiosk-grid">

    <!-- LEFT COLUMN: LIVE SCANNER CAMERA VIEWPORT & FEEDBACK -->
    <div class="kiosk-scanner-column">

      <div class="kiosk-card scanner-viewport-card">

        <!-- Kiosk Camera Status Bar -->
        <div class="scanner-status-bar">
          <div class="scanner-mode-tag">
            <span class="scanner-lens-icon">📷</span>
            <span id="scanner-status-text">Optical Scanner Ready</span>
          </div>
          <div class="scanner-camera-controls">
            <select id="camera-select" class="kiosk-select" title="Switch Camera Device">
              <option value="">Detecting cameras...</option>
            </select>
            <button type="button" id="btn-toggle-cam" class="kiosk-icon-btn" title="Pause / Resume Camera" onclick="toggleCamera()">
              <span id="cam-toggle-icon">⏸️</span>
            </button>
          </div>
        </div>

        <!-- CAMERA SCANNING AREA -->
        <div class="camera-viewport-wrapper">
          <div id="reader" class="camera-reader-box"></div>

          <!-- Futuristic Viewfinder Overlay -->
          <div id="viewfinder-overlay" class="viewfinder-overlay">
            <div class="viewfinder-corners">
              <span class="corner tl"></span>
              <span class="corner tr"></span>
              <span class="corner bl"></span>
              <span class="corner br"></span>
            </div>
            <div class="scanner-laser-beam" id="scanner-laser"></div>
            <div class="viewfinder-crosshair"></div>
            <div class="viewfinder-hint" id="viewfinder-hint">
              <span class="hint-icon">📱</span> Align Member QR Pass Inside Frame
            </div>
          </div>

          <!-- Camera Placeholder / Notice (shown if camera disabled or not granted) -->
          <div id="camera-placeholder" class="camera-placeholder" style="display:none;">
            <div class="placeholder-icon">📹</div>
            <div id="camera-placeholder-msg" class="placeholder-text">Camera scanner paused or permission required.</div>
            <button type="button" class="btn btn-sm btn-primary" onclick="restartCamera()" style="margin-top:0.75rem;">
              🔄 Start Camera
            </button>
          </div>

          <!-- LIVE RESULT OVERLAY (SUCCESS / DENIED BANNER) -->
          <div id="kiosk-result-overlay" class="kiosk-result-overlay" style="display:none;">
            <div id="kiosk-result-box" class="kiosk-result-box">
              <div id="kiosk-result-icon" class="kiosk-result-icon">✅</div>
              <div id="kiosk-result-title" class="kiosk-result-title">ENTRY GRANTED</div>
              <div id="kiosk-result-member" class="kiosk-result-member">Member Name</div>
              <div id="kiosk-result-message" class="kiosk-result-message">Attendance recorded. Welcome to FitZone!</div>
              
              <div id="kiosk-result-meta-row" class="kiosk-result-meta-row">
                <span id="kiosk-result-time" class="kiosk-result-chip">🕐 --:--</span>
                <span id="kiosk-result-badge" class="kiosk-result-chip">Active</span>
              </div>

              <div id="kiosk-result-warning" class="kiosk-result-warning" style="display:none;"></div>

              <!-- Auto-reset progress bar -->
              <div class="kiosk-reset-countdown">
                <div class="countdown-label">
                  <span>Ready for next member</span>
                  <span id="countdown-seconds">4s</span>
                </div>
                <div class="countdown-track">
                  <div id="countdown-bar" class="countdown-bar"></div>
                </div>
              </div>

              <button type="button" class="kiosk-next-btn" onclick="dismissResultNow()">
                Scan Next Member Now ↵
              </button>
            </div>
          </div>
        </div>

        <!-- Scanning Instructions Bar -->
        <div class="scanner-instructions-bar">
          <div class="instruction-item">
            <span class="step-badge">1</span>
            <span>Member opens <strong>FitZone</strong></span>
          </div>
          <div class="instruction-item">
            <span class="step-badge">2</span>
            <span>Generates <strong>30s Pass</strong></span>
          </div>
          <div class="instruction-item">
            <span class="step-badge">3</span>
            <span>Show QR to <strong>Camera</strong></span>
          </div>
          <div class="instruction-item">
            <span class="step-badge">4</span>
            <span>Automatic <strong>Check-In</strong></span>
          </div>
        </div>

        <!-- Collapsible Barcode Hardware Wedge / Manual Fallback -->
        <div class="kiosk-manual-toggle-row">
          <button type="button" class="manual-toggle-link" onclick="toggleManualInput()">
            ⌨️ Hardware Barcode Scanner / Manual Token Wedge <span id="manual-toggle-arrow">▾</span>
          </button>
        </div>

        <div id="manual-input-panel" class="manual-input-panel" style="display:none;">
          <div class="manual-input-group">
            <input type="text" id="scan-token-input" placeholder="Scan or paste 32-byte QR token..."
                   class="kiosk-input" autocomplete="off" spellcheck="false" />
            <button type="button" id="btn-scan-validate" class="btn btn-primary" onclick="validateToken()">
              🔍 Validate & Grant
            </button>
          </div>
          <small class="text-muted" style="font-size:0.75rem;margin-top:0.35rem;display:block;">
            Supports USB barcode wedge scanners, handheld optical readers, and manual token verification.
          </small>
        </div>

        <!-- Hidden legacy container for compatibility -->
        <div id="scan-result" style="display:none;">
          <div id="scan-result-card"></div>
        </div>

      </div>

    </div>

    <!-- RIGHT COLUMN: ENTRANCE METRICS, RECENT SCANS & KIOSK POLICIES -->
    <div class="kiosk-sidebar-column">

      <!-- Real-Time Scanner Telemetry -->
      <div class="kiosk-card telemetry-card">
        <div class="telemetry-header">
          <h2 class="telemetry-title">⚡ Entrance Status</h2>
          <span class="pulse-indicator"></span>
        </div>
        <div class="telemetry-stats-row">
          <div class="telemetry-stat">
            <div class="stat-value" id="stat-total-scans">0</div>
            <div class="stat-label">Total Scans</div>
          </div>
          <div class="telemetry-stat">
            <div class="stat-value text-success" id="stat-granted-scans">0</div>
            <div class="stat-label">Granted</div>
          </div>
          <div class="telemetry-stat">
            <div class="stat-value text-danger" id="stat-denied-scans">0</div>
            <div class="stat-label">Denied</div>
          </div>
        </div>
      </div>

      <!-- Recent Scans Live Feed -->
      <div class="kiosk-card log-card" id="scan-log-section">
        <div class="log-header">
          <div class="log-title-row">
            <h2 class="log-title">📋 Recent Scans</h2>
            <span class="log-live-badge">LIVE FEED</span>
          </div>
          <button type="button" class="btn-clear-log" onclick="clearScanLog()" title="Clear Live Display">Clear</button>
        </div>

        <div id="scan-log-list" class="kiosk-log-list">
          <div class="empty-log-state" id="empty-log-msg">
            <div style="font-size:1.5rem;margin-bottom:0.25rem;">📡</div>
            <div>Waiting for member scans...</div>
            <small class="text-muted">Scanned member access passes will appear here in real-time.</small>
          </div>
        </div>
      </div>

      <!-- Turnstile Security Rules Reference -->
      <div class="kiosk-card rules-card">
        <h3 class="rules-card-title">🛡️ Entrance Security Policies</h3>
        <ul class="rules-list">
          <li><strong>30-Second Dynamic TTL:</strong> Member QR codes auto-expire after 30s to prevent token sharing.</li>
          <li><strong>Single-Use Anti-Replay:</strong> Each token is invalidated immediately upon successful entrance.</li>
          <li><strong>3-Day Grace Buffer:</strong> Expired memberships have 3 grace days to renew with entrance alert.</li>
          <li><strong>Direct Attendance Log:</strong> Check-in attendance is stored in the database instantly.</li>
        </ul>
      </div>

    </div>

  </div>

</main>

<!-- Audio Synthesizer Beeps (Web Audio API - Zero External Dependencies) -->
<script>
function playKioskSound(type) {
  try {
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    if (!AudioCtx) return;
    const ctx = new AudioCtx();

    if (type === 'granted') {
      // Pleasant high double-chime (D5 -> A5)
      const osc1 = ctx.createOscillator();
      const gain1 = ctx.createGain();
      osc1.type = 'sine';
      osc1.frequency.setValueAtTime(587.33, ctx.currentTime);
      gain1.gain.setValueAtTime(0.2, ctx.currentTime);
      gain1.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);
      osc1.connect(gain1);
      gain1.connect(ctx.destination);
      osc1.start();
      osc1.stop(ctx.currentTime + 0.15);

      setTimeout(() => {
        const osc2 = ctx.createOscillator();
        const gain2 = ctx.createGain();
        osc2.type = 'sine';
        osc2.frequency.setValueAtTime(880, ctx.currentTime);
        gain2.gain.setValueAtTime(0.25, ctx.currentTime);
        gain2.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);
        osc2.connect(gain2);
        gain2.connect(ctx.destination);
        osc2.start();
        osc2.stop(ctx.currentTime + 0.25);
      }, 100);

    } else if (type === 'denied') {
      // Low denial buzzer (Sawtooth 160Hz -> 100Hz)
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(160, ctx.currentTime);
      osc.frequency.linearRampToValueAtTime(100, ctx.currentTime + 0.35);
      gain.gain.setValueAtTime(0.3, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.35);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.35);
    }
  } catch (e) {
    // Audio autoplay restrictions or unsupported
  }
}
</script>

<!-- HTML5-QRCODE CAMERA ENGINE (Loaded from Fast CDN) -->
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

<!-- KIOSK LOGIC & WEBCAM RUNTIME -->
<script>
(function() {
  const scanLog = [];
  let html5QrCode = null;
  let isScanningActive = false;
  let isProcessingToken = false;
  let autoResetTimer = null;
  let countdownInterval = null;
  let currentCameraId = null;

  let totalScans = 0;
  let grantedScans = 0;
  let deniedScans = 0;

  // 1. DIGITAL CLOCK
  function updateClock() {
    const now = new Date();
    const clockEl = document.getElementById('kiosk-digital-clock');
    const dateEl = document.getElementById('kiosk-digital-date');
    if (clockEl) {
      clockEl.textContent = now.toLocaleTimeString('en-IN', {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true
      }).toUpperCase();
    }
    if (dateEl) {
      dateEl.textContent = now.toLocaleDateString('en-IN', {
        weekday: 'short',
        year: 'numeric',
        month: 'short',
        day: 'numeric'
      }).toUpperCase();
    }
  }
  setInterval(updateClock, 1000);
  updateClock();

  // 2. CAMERA INITIALIZATION
  async function setupCamera() {
    const readerEl = document.getElementById('reader');
    const selectEl = document.getElementById('camera-select');
    const statusText = document.getElementById('scanner-status-text');

    if (typeof Html5Qrcode === 'undefined') {
      showCameraPlaceholder('QR scanning engine could not be loaded. Please check your internet connection or use manual input below.');
      return;
    }

    try {
      html5QrCode = new Html5Qrcode("reader");
      const cameras = await Html5Qrcode.getCameras();

      if (!cameras || cameras.length === 0) {
        showCameraPlaceholder('No camera devices detected. Connect a webcam or use the manual/barcode input below.');
        return;
      }

      selectEl.innerHTML = '';
      cameras.forEach((cam, idx) => {
        const opt = document.createElement('option');
        opt.value = cam.id;
        opt.textContent = cam.label || `Camera ${idx + 1}`;
        selectEl.appendChild(opt);
      });

      // Prefer back/rear camera for kiosks/mobile or first webcam
      const backCam = cameras.find(c => 
        c.label.toLowerCase().includes('back') || 
        c.label.toLowerCase().includes('rear') || 
        c.label.toLowerCase().includes('environment')
      );
      currentCameraId = backCam ? backCam.id : cameras[0].id;
      selectEl.value = currentCameraId;

      selectEl.addEventListener('change', (e) => {
        currentCameraId = e.target.value;
        restartCamera();
      });

      startCamera(currentCameraId);

    } catch (err) {
      console.warn('Camera detection error:', err);
      showCameraPlaceholder('Camera access denied or unavailable. Grant camera permission or use manual/barcode input below.');
    }
  }

  function startCamera(cameraId) {
    if (!html5QrCode) return;
    hideCameraPlaceholder();

    const config = {
      fps: 15,
      qrbox: function(viewfinderWidth, viewfinderHeight) {
        const minEdge = Math.min(viewfinderWidth, viewfinderHeight);
        const boxSize = Math.max(200, Math.floor(minEdge * 0.72));
        return { width: boxSize, height: boxSize };
      },
      aspectRatio: 1.0,
    };

    html5QrCode.start(
      cameraId,
      config,
      onQrCodeScanned,
      (errorMessage) => {
        // Continuous decoding frame feedback (safe to ignore frame mismatches)
      }
    ).then(() => {
      isScanningActive = true;
      document.getElementById('scanner-status-text').textContent = 'Optical Scanner Active';
      document.getElementById('cam-toggle-icon').textContent = '⏸️';
      document.getElementById('viewfinder-overlay').style.display = 'block';
    }).catch(err => {
      console.warn('Error starting camera:', err);
      showCameraPlaceholder('Failed to open camera stream. Ensure camera is not used by another app.');
    });
  }

  function stopCamera() {
    if (html5QrCode && isScanningActive) {
      html5QrCode.stop().then(() => {
        isScanningActive = false;
        document.getElementById('scanner-status-text').textContent = 'Scanner Paused';
        document.getElementById('cam-toggle-icon').textContent = '▶️';
        document.getElementById('viewfinder-overlay').style.display = 'none';
      }).catch(err => console.warn('Error stopping camera:', err));
    }
  }

  window.toggleCamera = function() {
    if (isScanningActive) {
      stopCamera();
      showCameraPlaceholder('Camera paused by operator.');
    } else {
      if (currentCameraId) {
        startCamera(currentCameraId);
      }
    }
  };

  window.restartCamera = function() {
    if (isScanningActive) {
      html5QrCode.stop().then(() => {
        isScanningActive = false;
        if (currentCameraId) startCamera(currentCameraId);
      }).catch(() => {
        if (currentCameraId) startCamera(currentCameraId);
      });
    } else {
      if (currentCameraId) startCamera(currentCameraId);
    }
  };

  function showCameraPlaceholder(msg) {
    const ph = document.getElementById('camera-placeholder');
    const phMsg = document.getElementById('camera-placeholder-msg');
    const overlay = document.getElementById('viewfinder-overlay');
    if (ph) {
      phMsg.textContent = msg;
      ph.style.display = 'flex';
    }
    if (overlay) overlay.style.display = 'none';
    document.getElementById('scanner-status-text').textContent = 'Scanner Offline';
    document.getElementById('cam-toggle-icon').textContent = '▶️';
    isScanningActive = false;
  }

  function hideCameraPlaceholder() {
    const ph = document.getElementById('camera-placeholder');
    if (ph) ph.style.display = 'none';
  }

  // 3. QR SCAN TRIGGER & SUBMISSION
  function onQrCodeScanned(decodedText) {
    if (isProcessingToken) return; // Prevent duplicate rapid trigger
    const token = (decodedText || '').trim();
    if (!token) return;

    // Send token to existing backend validation
    validateScannedToken(token);
  }

  // Common token validator used by both camera and manual/wedge input
  async function validateScannedToken(token) {
    if (isProcessingToken) return;
    isProcessingToken = true;

    // Visual pause on laser
    const laser = document.getElementById('scanner-laser');
    if (laser) laser.style.animationPlayState = 'paused';

    totalScans++;
    document.getElementById('stat-total-scans').textContent = totalScans;

    try {
      const res = await fetch('/admin/scan/validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token }),
      });
      const data = await res.json();

      if (data.success) {
        grantedScans++;
        document.getElementById('stat-granted-scans').textContent = grantedScans;
        playKioskSound('granted');

        if (data.warning) {
          showKioskResult({
            status: 'warning',
            icon: '⚠️',
            title: 'ENTRY GRANTED — GRACE PERIOD',
            member: data.memberName || 'Member',
            message: data.graceMessage || 'Active Grace Period. Please renew membership soon.',
            time: data.entryTime || new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }),
            badge: 'Grace Period',
            warning: data.graceMessage
          });
          addToLog(true, data.memberName || 'Member', data.entryTime, 'Grace Entry Granted');
        } else {
          showKioskResult({
            status: 'granted',
            icon: '✅',
            title: 'ENTRY GRANTED',
            member: data.memberName || 'Member',
            message: 'Attendance automatically recorded. Welcome to FitZone!',
            time: data.entryTime || new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }),
            badge: 'Access Granted',
            warning: null
          });
          addToLog(true, data.memberName || 'Member', data.entryTime, 'Attendance Logged');
        }
      } else {
        deniedScans++;
        document.getElementById('stat-denied-scans').textContent = deniedScans;
        playKioskSound('denied');

        showKioskResult({
          status: 'denied',
          icon: '🚫',
          title: 'ENTRY DENIED',
          member: data.memberName || 'Access Denied',
          message: data.message || 'Invalid or unauthorized QR pass.',
          time: new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }),
          badge: 'Denied',
          warning: null
        });
        addToLog(false, data.memberName || 'Unknown Member', '', data.message || 'Entry Denied');
      }

    } catch (err) {
      deniedScans++;
      document.getElementById('stat-denied-scans').textContent = deniedScans;
      playKioskSound('denied');

      showKioskResult({
        status: 'denied',
        icon: '⚠️',
        title: 'CONNECTION ERROR',
        member: 'Server Error',
        message: 'Could not connect to entrance validator. Check network connection.',
        time: '',
        badge: 'Error',
        warning: null
      });
      addToLog(false, 'System', '', 'Network Error');
    }
  }

  // 4. DISPLAY KIOSK RESULT OVERLAY WITH AUTO-RESET
  function showKioskResult(res) {
    const overlay = document.getElementById('kiosk-result-overlay');
    const box = document.getElementById('kiosk-result-box');
    const iconEl = document.getElementById('kiosk-result-icon');
    const titleEl = document.getElementById('kiosk-result-title');
    const memberEl = document.getElementById('kiosk-result-member');
    const msgEl = document.getElementById('kiosk-result-message');
    const timeEl = document.getElementById('kiosk-result-time');
    const badgeEl = document.getElementById('kiosk-result-badge');
    const warnEl = document.getElementById('kiosk-result-warning');
    const barEl = document.getElementById('countdown-bar');
    const secEl = document.getElementById('countdown-seconds');

    // Setup class
    box.className = 'kiosk-result-box result-' + res.status;
    iconEl.textContent = res.icon;
    titleEl.textContent = res.title;
    memberEl.textContent = res.member;
    msgEl.textContent = res.message;
    timeEl.textContent = res.time ? '🕐 ' + res.time : '';
    badgeEl.textContent = res.badge;

    if (res.warning) {
      warnEl.textContent = res.warning;
      warnEl.style.display = 'block';
    } else {
      warnEl.style.display = 'none';
    }

    overlay.style.display = 'flex';

    // Start 4-second countdown
    if (autoResetTimer) clearTimeout(autoResetTimer);
    if (countdownInterval) clearInterval(countdownInterval);

    let timeLeft = 4;
    secEl.textContent = timeLeft + 's';
    barEl.style.transition = 'none';
    barEl.style.width = '100%';

    setTimeout(() => {
      barEl.style.transition = 'width 4s linear';
      barEl.style.width = '0%';
    }, 50);

    countdownInterval = setInterval(() => {
      timeLeft--;
      if (timeLeft >= 0) secEl.textContent = timeLeft + 's';
    }, 1000);

    autoResetTimer = setTimeout(() => {
      dismissResultNow();
    }, 4100);
  }

  window.dismissResultNow = function() {
    if (autoResetTimer) clearTimeout(autoResetTimer);
    if (countdownInterval) clearInterval(countdownInterval);

    const overlay = document.getElementById('kiosk-result-overlay');
    if (overlay) overlay.style.display = 'none';

    const laser = document.getElementById('scanner-laser');
    if (laser) laser.style.animationPlayState = 'running';

    // Reset lock to accept next QR
    setTimeout(() => {
      isProcessingToken = false;
    }, 400);
  };

  // 5. RECENT SCANS LOG
  function addToLog(success, name, time, detail) {
    const timestamp = new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    scanLog.unshift({ success, name, time, detail, timestamp });
    if (scanLog.length > 25) scanLog.pop();
    renderLog();
  }

  function renderLog() {
    const listEl = document.getElementById('scan-log-list');
    const emptyEl = document.getElementById('empty-log-msg');
    if (!listEl) return;

    if (scanLog.length === 0) {
      if (emptyEl) emptyEl.style.display = 'block';
      return;
    }

    if (emptyEl) emptyEl.style.display = 'none';

    listEl.innerHTML = scanLog.map(item => `
      <div class="kiosk-log-item ${item.success ? 'log-granted' : 'log-denied'}">
        <div class="log-status-dot ${item.success ? 'dot-granted' : 'dot-denied'}">
          ${item.success ? '✓' : '✗'}
        </div>
        <div class="log-info-col">
          <div class="log-member-name">${item.name}</div>
          <div class="log-detail-text">${item.detail}</div>
        </div>
        <div class="log-meta-col">
          <span class="log-badge ${item.success ? 'badge-granted' : 'badge-denied'}">
            ${item.success ? 'GRANTED' : 'DENIED'}
          </span>
          <span class="log-timestamp">${item.timestamp}</span>
        </div>
      </div>
    `).join('');
  }

  window.clearScanLog = function() {
    scanLog.length = 0;
    renderLog();
  };

  // 6. MANUAL INPUT / HARDWARE BARCODE WEDGE HANDLER
  window.toggleManualInput = function() {
    const panel = document.getElementById('manual-input-panel');
    const arrow = document.getElementById('manual-toggle-arrow');
    if (panel.style.display === 'none' || !panel.style.display) {
      panel.style.display = 'block';
      arrow.textContent = '▴';
      document.getElementById('scan-token-input').focus();
    } else {
      panel.style.display = 'none';
      arrow.textContent = '▾';
    }
  };

  window.validateToken = function() {
    const input = document.getElementById('scan-token-input');
    const token = (input.value || '').trim();
    if (!token) {
      showKioskResult({
        status: 'denied',
        icon: '⚠️',
        title: 'NO TOKEN ENTERED',
        member: 'Hardware Input',
        message: 'Please paste or scan a member token into the field.',
        time: '',
        badge: 'Empty Input',
        warning: null
      });
      return;
    }
    input.value = '';
    validateScannedToken(token);
  };

  // Allow Enter key in manual input
  document.getElementById('scan-token-input').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      window.validateToken();
    }
  });

  // Spacebar hotkey to dismiss overlay quickly
  window.addEventListener('keydown', function(e) {
    if (e.code === 'Space' && document.getElementById('kiosk-result-overlay').style.display === 'flex') {
      const activeEl = document.activeElement;
      if (activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'SELECT')) return;
      e.preventDefault();
      dismissResultNow();
    }
  });

  // 7. START RUNTIME
  setupCamera();

})();
</script>

