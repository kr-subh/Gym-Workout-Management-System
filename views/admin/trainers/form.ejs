<%- include('../../partials/header') %>

<main class="dashboard-page">
  <div class="admin-header-row">
    <div>
      <div class="dashboard-eyebrow">Admin / Trainers / <%= isEdit ? 'Edit' : 'New' %></div>
      <h1><%= isEdit ? `Edit: ${trainer.name}` : 'Add New Trainer' %></h1>
    </div>
    <a href="/admin/trainers" class="btn btn-secondary">← All Trainers</a>
  </div>

  <% if (error) { %>
    <div class="alert alert-error" style="margin-bottom:1.5rem;"><%= error %></div>
  <% } %>

  <div class="auth-card" style="max-width:560px; margin:0 auto;">
    <form action="<%= isEdit ? '/admin/trainers/' + trainer._id + '/edit' : '/admin/trainers' %>" method="POST" class="auth-form">

      <div class="form-group">
        <label for="name">Full Name</label>
        <input type="text" id="name" name="name" required value="<%= trainer.name || '' %>" placeholder="Trainer name" />
      </div>

      <div class="form-group">
        <label for="email">Email Address<% if (isEdit) { %> <span class="optional">(read-only)</span><% } %></label>
        <input type="email" id="email" name="email" required value="<%= trainer.email || '' %>"
               placeholder="trainer@fitzone.com" <%= isEdit ? 'readonly style="opacity:0.6;"' : '' %> />
      </div>

      <div class="form-group">
        <label for="phone">Phone Number</label>
        <input type="tel" id="phone" name="phone" value="<%= trainer.phone || '' %>" placeholder="+91 98765 43210" />
      </div>

      <% if (!isEdit) { %>
        <div class="form-group">
          <label for="password">Initial Password</label>
          <input type="password" id="password" name="password" required placeholder="Min. 6 characters" />
        </div>
      <% } %>

      <div style="display:flex;gap:0.75rem;margin-top:1rem;">
        <a href="/admin/trainers" class="btn btn-secondary" style="flex:1;text-align:center;">Cancel</a>
        <button type="submit" class="btn btn-primary" style="flex:2;"><%= isEdit ? 'Save Changes' : 'Add Trainer' %></button>
      </div>
    </form>
  </div>
</main>

<%- include('../../partials/footer') %>
