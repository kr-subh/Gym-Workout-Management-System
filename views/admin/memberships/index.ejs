<%- include('../../partials/header') %>

<main class="dashboard-page">
  <div class="admin-header-row">
    <div>
      <div class="dashboard-eyebrow">Admin Portal</div>
      <h1>Membership Plans</h1>
      <p>Create, update, or remove membership tiers and configure their feature offerings.</p>
    </div>
    <div class="header-actions">
      <a href="/admin/dashboard" class="btn btn-secondary">← Back to Dashboard</a>
      <a href="/admin/memberships/new" class="btn btn-primary">+ Add New Plan</a>
    </div>
  </div>

  <% if (successMsg) { %>
    <div class="alert alert-success" style="margin-top: 1.5rem;"><%= successMsg %></div>
  <% } %>
  <% if (errorMsg) { %>
    <div class="alert alert-error" style="margin-top: 1.5rem;"><%= errorMsg %></div>
  <% } %>

  <div class="plans-admin-grid">
    <% if (plans.length === 0) { %>
      <div class="empty-state">
        <p>No membership plans found. Click "+ Add New Plan" to create one.</p>
      </div>
    <% } %>

    <% plans.forEach(plan => { %>
      <div class="plan-admin-card <%= plan.level === 'Pro+' ? 'card-highlight-gold' : (plan.level === 'Pro' ? 'card-highlight-orange' : '') %>">
        <div class="plan-card-top">
          <div>
            <span class="badge badge-<%= plan.level.toLowerCase().replace('+', '-plus') %>"><%= plan.level %></span>
            <h3 class="plan-title"><%= plan.name %></h3>
          </div>
          <div class="plan-price-block">
            <span class="plan-currency">₹</span>
            <span class="plan-amount"><%= plan.price %></span>
            <span class="plan-duration">/ <%= plan.duration %></span>
          </div>
        </div>

        <div class="plan-features-section">
          <h4>Included Features (<%= plan.features.length %>):</h4>
          <ul class="plan-features-list">
            <% plan.features.forEach(feat => { %>
              <li>
                <span class="check-icon">✓</span>
                <span><%= feat %></span>
              </li>
            <% }) %>
          </ul>
        </div>

        <div class="plan-admin-actions">
          <a href="/admin/memberships/<%= plan._id %>/edit" class="btn btn-sm btn-outline">Edit Plan</a>
          <form action="/admin/memberships/<%= plan._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this plan?');">
            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
</main>

<%- include('../../partials/footer') %>
